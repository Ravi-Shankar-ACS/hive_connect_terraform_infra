# Terraform working directories (scripts/tf.sh keeps one per environment under .terraform/<env>)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plans and their readable copies (contain resource details; never commit)
.plans/
*.tfplan

