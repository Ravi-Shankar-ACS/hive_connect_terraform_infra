tests/fixture/.terraform/
tests/fixture/terraform.tfstate*

# Local secret files used with `aws secretsmanager put-secret-value`
*.secret.json

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local test output
.terratest.log
