variable "engine_version" {
  description = "PostgreSQL major version."
  type        = string
  default     = "17"
}

variable "instance_class" {
  description = "Instance class."
  type        = string
  default     = "db.t4g.medium"
}

variable "allocated_storage" {
  description = "Initial gp3 storage (GB)."
  type        = number
  default     = 50
}

variable "max_allocated_storage" {
  description = "Storage autoscaling ceiling (GB)."
  type        = number
  default     = 200
}

variable "multi_az" {
  description = "Standby in a second AZ."
  type        = bool
  default     = false
}

variable "db_name" {
  description = "Database created with the instance."
  type        = string
}

variable "master_username" {
  description = "Master user name (the password is generated by RDS)."
  type        = string
}

variable "backup_retention_days" {
  description = "Point-in-time recovery window."
  type        = number
  default     = 14
}

variable "deletion_protection" {
  description = "Block deletion of the database."
  type        = bool
  default     = true
}

variable "apply_immediately" {
  description = "Apply database changes now instead of in the maintenance window."
  type        = bool
  default     = false
}

variable "log_retention_days" {
  description = "PostgreSQL log retention."
  type        = number
  default     = 30
}
